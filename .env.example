SAMAYA_HOST=0.0.0.0
SAMAYA_PORT=8765
SAMAYA_SOCKET=/root/.codex/app-server-control/app-server-control.sock
# 常用目录快捷入口，不限制访问范围；多个入口使用冒号分隔。
SAMAYA_ROOTS=/workspace
SAMAYA_DATA_DIR=.samaya
# 远程部署必须设置随机长口令，并通过 HTTPS 反向代理访问。
SAMAYA_TOKEN=
SAMAYA_SECURE_COOKIE=false
# 同时配置证书和私钥后，服务直接提供 HTTPS；相对路径以启动目录为准。
SAMAYA_SSL_CERTFILE=
SAMAYA_SSL_KEYFILE=
# 仅加密私钥需要设置。
SAMAYA_SSL_KEYFILE_PASSWORD=
